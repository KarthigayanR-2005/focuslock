# TEST-ONLY Vercel demo with a shared Neon PostgreSQL database. Not for real student data.
# Easiest: run `python -m scripts.vercel_setup` from the backend folder. It creates the tables and demo accounts
# and writes all of these, with fresh keys, to .env.vercel.local for pasting into Vercel > Settings > Environment Variables.
#
# Why Neon and not MOCK_DATA on Vercel: MOCK_DATA keeps a separate SQLite file in each Vercel function instance,
# so a teacher and a student can land on different instances and see different data or get logged out.
# One shared database fixes that. (MOCK_DATA is fine on Render, which runs a single always-on process.)

# From Neon (Project > Connection string). postgres:// and postgresql:// both work; keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
APP_ENV=development
ENABLE_DEV_AUTH=true
# The password for every demo account (teacher@focuslock.test, student@focuslock.test, ...). Use a strong one.
DEV_PASSWORD=change-me-to-a-strong-password
# Different random strings, 32+ characters each: python -c "import secrets; print(secrets.token_urlsafe(48))"
QR_SIGNING_KEY=replace-with-random-48-chars
POLICY_SIGNING_KEY=replace-with-random-48-chars
BLE_TOKEN_KEY=replace-with-random-48-chars
CRON_SECRET=replace-with-random-32-chars
FACE_CHECK_MODE=off
PLAY_INTEGRITY_MODE=off
RESOURCE_ALLOWED_HOSTS=college.example.edu,docs.college.example.edu
# Do NOT set MOCK_DATA on Vercel.
# Phone build (debug) pointing at the deployment:
#   cd android; .\gradlew.bat :app:installDebug -PAPI_BASE_URL=https://YOUR-APP.vercel.app/api
